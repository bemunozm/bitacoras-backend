// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tokens {
  id        Int    @id @default(autoincrement())
  value     Int
  user_id   Int
  created_at DateTime @default(now())
  expires_at   DateTime
  users     users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id        Int   @id @default(autoincrement())
  name      String
  run       String   @unique
  job_position String?
  email     String   @unique
  phone     String?
  password  String
  profile_image String?
  is_confirmed Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  roles     role_user[] 
  residences residence_user[]
  bitacoras  bitacoras[]
  tokens    tokens[]
  programs  programs[]
}

model role_user {
  id        Int   @id @default(autoincrement())
  role_id   Int
  user_id   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roles      roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)
}

model roles {
  id        Int   @id @default(autoincrement())
  name      String
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users     role_user[]
}

model residence_user {
  id           Int   @id @default(autoincrement())
  residence_id Int
  user_id      Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  users         users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  residences    residences @relation(fields: [residence_id], references: [id], onDelete: Cascade)
}

model residences {
  id        Int   @id @default(autoincrement())
  name      String
  address   String
  capacity  Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users     residence_user[]
  programs program_residence[]
  participants participant_residence[]
}

model bitacoras {
  id           Int    @id @default(autoincrement())
  month        DateTime @default(now())
  recipe       String
  user_id      Int
  program_id   Int
  status       String   @default("En Progreso")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  users         users      @relation(fields: [user_id], references: [id])
  programs      programs   @relation(fields: [program_id], references: [id])
  activities    activities[]
}

model program_residence {
  id           Int   @id @default(autoincrement())
  program_id   Int
  residence_id Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  programs     programs   @relation(fields: [program_id], references: [id], onDelete: Cascade)
  residences   residences @relation(fields: [residence_id], references: [id], onDelete: Cascade)
}

model programs {
  id        Int    @id @default(autoincrement())
  name      String
  company  String
  address   String
  state     String
  coordinator_id   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  coordinator     users @relation(fields: [coordinator_id], references: [id])
  residences      program_residence[]
  bitacoras  bitacoras[]
}

model activities {
  id        Int    @id @default(autoincrement())
  description String
  date       DateTime
  bitacora_id Int
  category_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  bitacoras  bitacoras  @relation(fields: [bitacora_id], references: [id])
  categories categories @relation(fields: [category_id], references: [id])
  attachments attachments[]
}

model categories {
  id        Int    @id @default(autoincrement())
  name      String
  description String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  activities activities[]
}


model attachments {
  id        Int    @id @default(autoincrement())
  image     String
  activity_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  activity  activities @relation(fields: [activity_id], references: [id], onDelete: Cascade)
}

model participant_residence {
  id           Int   @id @default(autoincrement())
  residence_id Int
  participant_id Int
  admission_date DateTime @default(now())
  departure_date DateTime?
  status       String
  admission_notes        String?
  departure_notes        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  residences   residences @relation(fields: [residence_id], references: [id], onDelete: Cascade)
  participants participants @relation(fields: [participant_id], references: [id], onDelete: Cascade)
}

model participants {
  id        Int    @id @default(autoincrement())
  name      String
  run       String  @unique
  gender    String
  birthdate DateTime?
  nationality String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  residences participant_residence[]
  events       events[]
  diseases     disease_participant[]
  provisions participant_provision[]
}

model disease_participant {
  id        Int    @id @default(autoincrement())
  participant_id Int
  disease_id Int
  date     DateTime
  treatment_status   String
  comments  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  participants participants @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  diseases diseases @relation(fields: [disease_id], references: [id], onDelete: Cascade)
}


model diseases {
  id        Int    @id @default(autoincrement())
  name      String
  description String?
  type      String
  treatment_required Boolean @default(false)
  contagious Boolean @default(false)
  notes     String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  participants disease_participant[]
}

model events {
  id        Int    @id @default(autoincrement())
  date      DateTime
  description String
  type      String
  participant_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  participant participants @relation(fields: [participant_id], references: [id], onDelete: Cascade)
}

model participant_provision {
  id       Int    @id @default(autoincrement())
  participant_id Int
  provision_id Int
  date     DateTime
  turn String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  participant participants @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  provision provisions @relation(fields: [provision_id], references: [id], onDelete: Cascade)
}

model provisions {
  id        Int    @id @default(autoincrement())
  name      String
  description String?
  provision_category_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  category provision_categories @relation(fields: [provision_category_id], references: [id], onDelete: Cascade)
  participants participant_provision[]
}

model provision_categories {
  id        Int    @id @default(autoincrement())
  name      String
  description String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  provisions provisions[]
}